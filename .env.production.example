# Production env example for the docker-compose.prod.yml stack.
# Copy to .env.production and fill in real values. DO NOT COMMIT the filled file.
#
# Quick start (local plain-HTTP smoke test):
#   cp .env.production.example .env.production
#   sed -i 's|^BACKEND_DOMAIN=.*|BACKEND_DOMAIN=:80|' .env.production
#   sed -i 's|^FRONTEND_URL=.*|FRONTEND_URL=http://localhost|' .env.production
#   # set POSTGRES_PASSWORD and JWT_SECRET to anything ≥32 bytes
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#   curl http://localhost/health   # should print {"status":"ok"}

# ----- Reverse proxy / TLS -----
# Caddy site address. In prod set to your API hostname (e.g. api.corewar.example.com)
# and Caddy will auto-provision a Let's Encrypt cert. For local plain-HTTP testing,
# set to ":80".
BACKEND_DOMAIN=api.example.com
# Contact email Caddy registers with Let's Encrypt. Required when BACKEND_DOMAIN
# is a real hostname; can be left blank for local ":80" runs.
ACME_EMAIL=you@example.com

# ----- Backend app -----
# Used by axum CORS — must exactly match the frontend origin (Cloudflare Pages URL).
FRONTEND_URL=https://corewar.example.com
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-strong-secret-at-least-32-bytes
# Comma-separated IPs of proxies whose X-Forwarded-For headers the backend should
# trust for rate-limit keying. Caddy lives on the docker network so its IP is
# dynamic; leave blank unless you've pinned it.
TRUSTED_PROXIES=

# ----- Database -----
POSTGRES_USER=corewar
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=corewar
# Hostname "postgres" resolves to the postgres service on the docker network.
DATABASE_URL=postgresql://corewar:replace-me-with-a-strong-password@postgres:5432/corewar

# ----- Redis -----
REDIS_URL=redis://redis:6379
