// Code that runs in Node: the Vite config, the build-time dist guard, and
// tests that read files off disk (node:fs). Keep this list to files that
// actually import node:* — anything else belongs in tsconfig.app.json.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["vite.config.ts", "src/deploy", "src/routes.test.ts", "src/styles/tokens.test.ts"]
}
